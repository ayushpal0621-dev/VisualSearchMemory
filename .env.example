# VisualSearch Memory - Environment Configuration

# General
PROJECT_NAME="VisualSearch Memory"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL for production/docker, SQLite supported for local dev)
DATABASE_URL="sqlite:///./data/storage/visualsearch.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visualsearch"

# Qdrant Vector Database
# Set QDRANT_URL to empty string or leave unconfigured to use local embedded storage
QDRANT_URL="http://localhost:6333"
QDRANT_STORAGE_PATH="./data/qdrant_storage"
QDRANT_COLLECTION_NAME="visual_memory"

# Redis Cache & Worker (Optional)
REDIS_URL="redis://localhost:6379/0"
USE_CELERY=false

# Ollama LLM Assistant
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_SECONDS=15

# Storage
STORAGE_PATH="./data/storage"
MAX_UPLOAD_SIZE_MB=50

# Multimodal Embedding Model
# Options: ViT-B-32 (OpenCLIP), ViT-B-16, ViT-L-14
EMBEDDING_MODEL="ViT-B-32"
EMBEDDING_PRETRAINED="laion2b_s34b_b79k"
EMBEDDING_DIMENSION=512

# Retrieval Weights
DEFAULT_SEMANTIC_WEIGHT=0.6
DEFAULT_KEYWORD_WEIGHT=0.3
DEFAULT_METADATA_WEIGHT=0.1

# Security & CORS
CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]'
